# Local development configuration. Production uses deploy/paliro.production.env.example.
PORT=3001
PALIRO_MYSQL_HOST=127.0.0.1
PALIRO_MYSQL_PORT=3306
PALIRO_MYSQL_DATABASE=paliro_account_dev
PALIRO_MYSQL_USER=paliro_dev
PALIRO_MYSQL_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_PASSWORD
PALIRO_SESSION_HOURS=24
# Exact development origins only. Never use * with credentials.
PALIRO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost
LOG_LEVEL=info
